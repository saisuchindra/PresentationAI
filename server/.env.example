# PresentationAI Server Environment Variables

PORT=5000

# OpenRouter API Key (Get one from https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Image Search APIs (Optional, fallbacks are included)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# Supabase Configuration (Optional, falls back to local sqlite/JSON database)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Default AI Model (e.g. google/gemini-2.5-flash, google/gemini-2.5-pro, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct)
DEFAULT_MODEL=google/gemini-2.5-flash
